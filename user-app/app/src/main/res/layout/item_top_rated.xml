<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dashboard_components_bg"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <!-- Avatar -->
    <FrameLayout
        android:layout_width="75dp"
        android:layout_height="75dp">

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/auth_bg"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_avatar"
            android:clipToOutline="true"/>

        <!-- Online dot -->

        <View
            android:id="@+id/onlineDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_dot_online_with_border"
            android:layout_gravity="top|end"
            android:translationX="2dp"
            android:translationY="-2dp"/>

    </FrameLayout>

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/name"
            android:text="Rahul Sharma"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#111827"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/service"
            android:text="MASTER ELECTRICIAN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#5B4DB1"
            android:layout_marginTop="2dp"/>

        <!-- Distance -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_location"
                app:tint="#9CA3AF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/distance"
                android:text="1.2 km"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Availability -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/status"
            android:text="Available"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#16A34A"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="end">

        <!-- Rating pill -->
        <LinearLayout
            android:id="@+id/ratingContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_rating_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ratingIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_star"
                app:tint="#F59E0B"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/rating"
                android:text="4.9"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Button -->
        <TextView
            android:id="@+id/actionBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOOK NOW"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_primary_round"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginTop="10dp"/>
    </LinearLayout>

</LinearLayout>