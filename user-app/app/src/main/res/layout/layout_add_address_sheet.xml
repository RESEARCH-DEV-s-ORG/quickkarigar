<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HANDLE -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_handle"
            android:layout_marginBottom="10dp"/>

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/title"
                android:text="Add New Address"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Provide details for your service location"
                android:textSize="13sp"
                android:layout_below="@id/title"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_cross"
                app:tint="#999"/>
        </RelativeLayout>

        <!-- MAP / LOCATION PREVIEW android:background="@drawable/bg_map_preview"-->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"

            android:gravity="center">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_location"
                app:tint="@color/primary"/>
        </FrameLayout>


        <TextView
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="House / Flat / Block No."
            android:textAllCaps="true"/>
        <!-- HOUSE -->
        <EditText
            android:textSize="16sp"
            android:id="@+id/etHouse"
            android:hint="eg. Swapna Apartment II."
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_add_address_input"
            android:paddingHorizontal="14dp"/>

        <!-- AREA -->
        <TextView
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Apartment / Road / Area"
            android:textAllCaps="true"/>
        <EditText
            android:textSize="16sp"
            android:id="@+id/etArea"
            android:hint="eg. Mukandapur, Greenlane road."
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_add_address_input"
            android:paddingHorizontal="14dp"/>

        <!-- CITY + PIN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City"
                    android:textAllCaps="true"/>

                <EditText
                    android:textSize="16sp"
                    android:id="@+id/etCity"
                    android:hint="Kolkata"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_add_address_input"
                    android:paddingHorizontal="14dp"/>
            </LinearLayout>


            <LinearLayout
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pincode"
                    android:textAllCaps="true"/>

                <EditText
                    android:textSize="16sp"
                    android:id="@+id/etPincode"
                    android:hint="700099"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_add_address_input"
                    android:paddingHorizontal="14dp"
                    android:inputType="number"/>
            </LinearLayout>



        </LinearLayout>

        <!-- PRIMARY SWITCH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_primary_address_card">

            <!-- ICON BOX -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:layout_marginEnd="10dp"
                android:foregroundGravity="center">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_star"
                    app:tint="@color/primary"/>
            </FrameLayout>

            <!-- TEXT -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Set as primary address"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2B2B2B"/>

            <!-- SWITCH -->
            <Switch
                android:id="@+id/switchPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/white"
                android:trackTint="@color/switch_track_selector"/>
        </LinearLayout>

        <!-- BUTTON -->
        <LinearLayout
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_bg_address_selector"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVE &amp; CONTINUE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>