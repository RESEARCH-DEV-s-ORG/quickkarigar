<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_auth_sheet">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="#DDD"
        android:layout_marginBottom="16dp"/>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login with Email"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your email to receive OTP"
        android:textSize="16sp"
        android:textColor="#777"
        android:layout_marginTop="4dp"/>

    <!-- Email Input -->
    <EditText
        android:id="@+id/emailInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:hint="Enter email address"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:background="@drawable/btn_outline_round"
        android:padding="14dp"
        android:textSize="16sp"/>

    <!-- Continue Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp">

        <!-- Button -->
        <Button
            android:id="@+id/btnSendEmailOtp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Continue"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_primary_round"
            android:enabled="false"
            android:alpha="0.5"/>

        <!-- Loader -->
        <ProgressBar
            android:id="@+id/progressEmailOtp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminate="true"/>
    </FrameLayout>

</LinearLayout>