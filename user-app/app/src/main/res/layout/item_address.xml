<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_address_item"
    android:gravity="center_vertical"

    android:clickable="true"
    android:focusable="false">

    <!-- ICON -->
    <ImageView
        android:id="@+id/icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_color_primary"
        android:padding="10dp"
        android:src="@drawable/ic_home"
        app:tint="@color/white"/>

    <!-- TEXT AREA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <!-- TITLE + DEFAULT TAG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- TITLE -->
            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Home"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- DEFAULT BADGE -->
            <TextView
                android:id="@+id/defaultTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEFAULT"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_default_tag"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mukhandapur, Kolkata"
            android:textSize="12sp"
            android:textColor="#777"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="70dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>

    <!-- EDIT ICON -->
    <ImageView
        android:id="@+id/editBtn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/cicular_white_stock_bg"
        android:padding="8dp"
        android:src="@drawable/ic_edit"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:tint="#888"/>
</LinearLayout>