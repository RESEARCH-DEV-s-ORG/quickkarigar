<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_auth_sheet">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="#DDD"
        android:layout_marginBottom="16dp"/>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login with Phone"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000"/>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="We will send you a verification code"
        android:textSize="14sp"
        android:textColor="#777"
        android:layout_marginTop="4dp"/>

    <!-- Phone Input Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/btn_outline_round"
        android:paddingHorizontal="12dp">

        <!-- Country Code -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+91"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000"/>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#DDD"
            android:layout_marginHorizontal="10dp"/>

        <!-- Phone Input -->
        <EditText
            android:id="@+id/phoneInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Enter mobile number"
            android:inputType="number"
            android:maxLength="10"
            android:background="@android:color/transparent"
            android:textSize="16sp"
            android:textColor="#000"
            android:padding="0dp"/>
    </LinearLayout>

    <!-- Continue Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp">

        <!-- Actual Button -->
        <Button
            android:id="@+id/btnSendOtp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Continue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_primary_round"
            android:enabled="false"
            android:alpha="0.5"/>

        <!-- Loader -->
        <ProgressBar
            android:id="@+id/progressSendOtp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminate="true"/>
    </FrameLayout>

</LinearLayout>