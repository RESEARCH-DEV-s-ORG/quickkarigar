<!DOCTYPE html>

<html class="scroll-smooth" lang="en"><head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Quick Karigar - Partner Registration</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <style>
        :root {
            --blueprint-dot: rgba(26, 35, 126, 0.05);
        }
        body {
            font-family: 'Manrope', sans-serif;
            background-color: #f8f9fa;
            background-image: radial-gradient(var(--blueprint-dot) 1px, transparent 1px);
            background-size: 24px 24px;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .step-active {
            @apply border-primary text-primary font-bold;
        }
        .blueprint-border {
            border: 1px solid #E1E2E9;
        }
        .glass-header {
            background: rgba(248, 249, 250, 0.9);
            backdrop-filter: blur(12px);
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-background": "#191c1d",
                        "error-container": "#ffdad6",
                        "background": "#f8f9fa",
                        "inverse-surface": "#2e3132",
                        "surface-container-high": "#e7e8e9",
                        "surface-variant": "#e1e3e4",
                        "primary-fixed-dim": "#bdc2ff",
                        "surface-container-highest": "#e1e3e4",
                        "on-tertiary-fixed-variant": "#434750",
                        "on-secondary-container": "#526772",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed": "#000767",
                        "secondary-fixed": "#cfe6f2",
                        "surface-container": "#edeeef",
                        "on-secondary-fixed": "#071e27",
                        "surface-container-lowest": "#ffffff",
                        "secondary-fixed-dim": "#b4cad6",
                        "tertiary-fixed-dim": "#c4c6d2",
                        "error": "#BA1A1A",
                        "on-surface-variant": "#454652",
                        "surface": "#f8f9fa",
                        "on-error-container": "#93000a",
                        "secondary-container": "#cfe6f2",
                        "inverse-primary": "#bdc2ff",
                        "on-tertiary-container": "#9597a2",
                        "surface-bright": "#f8f9fa",
                        "tertiary-container": "#2c3039",
                        "tertiary": "#181b23",
                        "on-surface": "#191c1d",
                        "surface-dim": "#d9dadb",
                        "on-primary-fixed-variant": "#343d96",
                        "primary": "#000666",
                        "tertiary-fixed": "#e0e2ee",
                        "blueprint-dot": "rgba(26, 35, 126, 0.03)",
                        "on-error": "#ffffff",
                        "inverse-on-surface": "#f0f1f2",
                        "on-secondary-fixed-variant": "#354a53",
                        "on-primary-container": "#8690ee",
                        "on-tertiary": "#ffffff",
                        "secondary": "#4c616c",
                        "surface-tint": "#4c56af",
                        "primary-container": "#1a237e",
                        "primary-fixed": "#e0e0ff",
                        "on-tertiary-fixed": "#181b24",
                        "on-primary": "#ffffff",
                        "outline": "#767683",
                        "surface-container-low": "#f3f4f5",
                        "outline-variant": "#c6c5d4"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "section-gap-desktop": "96px",
                        "container-max": "1280px",
                        "margin-desktop": "80px",
                        "gutter": "16px",
                        "unit": "8px",
                        "section-gap-mobile": "48px",
                        "margin-mobile": "20px"
                    },
                    "fontFamily": {
                        "display-lg-mobile": ["Manrope"],
                        "label-md": ["Manrope"],
                        "title-lg": ["Manrope"],
                        "headline-lg": ["Manrope"],
                        "body-lg": ["Manrope"],
                        "label-sm": ["Manrope"],
                        "body-md": ["Manrope"],
                        "display-lg": ["Manrope"],
                        "headline-lg-mobile": ["Manrope"]
                    },
                    "fontSize": {
                        "display-lg-mobile": ["36px", {"lineHeight": "1.1", "fontWeight": "800"}],
                        "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.02em", "fontWeight": "700"}],
                        "title-lg": ["20px", {"lineHeight": "28px", "fontWeight": "700"}],
                        "headline-lg": ["40px", {"lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "800"}],
                        "body-lg": ["20px", {"lineHeight": "1.6", "fontWeight": "400"}],
                        "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "800"}],
                        "body-md": ["16px", {"lineHeight": "1.6", "fontWeight": "400"}],
                        "display-lg": ["60px", {"lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "800"}],
                        "headline-lg-mobile": ["30px", {"lineHeight": "1.2", "fontWeight": "800"}]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-background text-on-background">
<!-- TopNavBar -->
<header class="fixed top-0 w-full z-50 glass-header border-b border-outline-variant shadow-sm h-16 flex justify-between items-center px-margin-mobile md:px-margin-desktop">
    <div class="flex items-center gap-4">
        <span class="font-display-lg-mobile text-display-lg-mobile font-extrabold text-primary">Quick Karigar</span>
        <div class="hidden md:flex h-8 w-[1px] bg-outline-variant mx-2"></div>
        <span class="hidden md:block font-label-md text-label-md text-on-surface-variant">Partner Onboarding</span>
    </div>
    <div class="flex items-center gap-4">
        <button class="material-symbols-outlined p-2 hover:bg-surface-container-high transition-all duration-200 rounded-full text-on-surface-variant">notifications</button>
        <button class="material-symbols-outlined p-2 hover:bg-surface-container-high transition-all duration-200 rounded-full text-on-surface-variant">help_outline</button>
        <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container font-bold overflow-hidden border-2 border-primary">
            <img alt="Partner Profile" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBZvRnl2P9Y8a8VyhhECcQ3lBC-Tr9ZxrZswif2sra6XPmibonnzJr4e97LHFCee5dJUustmcuIOZPPzf2fJ5n_aKvIh54w48VXkiuF20-_KeoMxZGMDIHa_elYfm6TkbyW1j4C0OzwNB-RN8cIRAxuHNMFMrC4AvqXjAMUDhjTWXfqs7iYOMyl27vJEAXas06YzY2Eo8CrK_AqiMyAaNO0sRfQ27KwQid_sikPrck3yT3c7urJfM-BCNg-0tO0-OlkORex7n795MEe"/>
        </div>
    </div>
</header>
<div class="pt-16 max-w-container-max mx-auto flex">
    <!-- SideNavBar / Stepper Navigation -->
    <aside class="hidden md:flex flex-col w-64 h-[calc(100vh-64px)] fixed p-4 gap-2 border-r border-outline-variant bg-surface-container-low overflow-y-auto">
        <div class="mb-6 px-2">
            <h2 class="font-title-lg text-title-lg font-extrabold text-primary">Partner Portal</h2>
            <p class="font-label-md text-label-md text-on-tertiary-container">Onboarding Progress</p>
            <div class="mt-4 w-full bg-surface-variant h-2 rounded-full overflow-hidden">
                <div class="bg-primary h-full transition-all duration-500" id="progress-bar" style="width: 20%;"></div>
            </div>
        </div>
        <nav class="flex flex-col gap-1">
            <a class="nav-item flex items-center gap-3 p-3 bg-primary-container text-on-primary-container font-bold rounded-lg transition-transform hover:translate-x-1" data-step="1" href="#business-identity">
                <span class="material-symbols-outlined">business_center</span>
                <span class="font-label-md">Business Info</span>
            </a>
            <a class="nav-item flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant rounded-lg transition-transform hover:translate-x-1" data-step="2" href="#skills-expertise">
                <span class="material-symbols-outlined">construction</span>
                <span class="font-label-md">Services</span>
            </a>
            <a class="nav-item flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant rounded-lg transition-transform hover:translate-x-1" data-step="3" href="#verification">
                <span class="material-symbols-outlined">verified_user</span>
                <span class="font-label-md">Verification</span>
            </a>
            <a class="nav-item flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant rounded-lg transition-transform hover:translate-x-1" data-step="4" href="#equipment">
                <span class="material-symbols-outlined">inventory_2</span>
                <span class="font-label-md">Equipment</span>
            </a>
            <a class="nav-item flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant rounded-lg transition-transform hover:translate-x-1" data-step="5" href="#review">
                <span class="material-symbols-outlined">fact_check</span>
                <span class="font-label-md">Review</span>
            </a>
        </nav>
        <div class="mt-auto p-4 bg-primary text-white rounded-xl shadow-xl space-y-2">
            <p class="font-label-sm uppercase tracking-widest opacity-80">Support Status</p>
            <div class="flex items-center gap-2">
<span class="relative flex h-3 w-3">
<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
<span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
</span>
                <span class="font-label-md font-bold">Agents Online</span>
            </div>
            <button class="w-full py-2 bg-white text-primary rounded font-bold text-sm hover:bg-opacity-90 transition-all">Chat Now</button>
        </div>
    </aside>
    <!-- Main Content Canvas -->
    <main class="w-full md:ml-64 p-margin-mobile md:p-12 space-y-section-gap-mobile md:space-y-section-gap-desktop pb-32">
        <!-- Hero Introduction -->
        <section class="relative overflow-hidden rounded-xl bg-primary-container p-8 md:p-16 text-on-primary">
            <div class="relative z-10 max-w-2xl">
                <span class="inline-block px-3 py-1 bg-white/10 rounded-full font-label-sm uppercase tracking-widest mb-4">Partner Application</span>
                <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-6 text-on-primary-container">Build your professional future with Quick Karigar.</h1>
                <p class="font-body-lg text-body-lg opacity-90 mb-8">Join the elite network of verified professionals. Complete your profile to start receiving high-value service requests in your area.</p>
            </div>
            <div class="absolute right-0 top-0 bottom-0 w-1/3 hidden lg:block opacity-20 pointer-events-none">
                <img alt="Industrial Blueprint" class="w-full h-full object-contain" data-alt="A clean industrial blueprint illustration showing technical drawings of home maintenance tools and house layouts. The style is minimalist with thin white lines on a deep navy blue background, mirroring a high-end corporate engineering aesthetic. Soft ambient lighting effects enhance the technical and professional mood." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCdblSvT_x93Z7OFc5jFshxOqQ6e9TV3jJj9LoJRYLuuulmMYUhmvb5SQFOeouKPlnOd49H40rzvuDzPJ5jJiyuEhyxQx0hCxNQnZD0C2Yw6REDwbhZc8SJq86YmxLbAWGe0g_ZOnMNJXfcpK7Ix-_FKsOlfAd2IkfhE6TFz9Chv_6QV-kU0tM1g4jaBD-ZmUsUKrxsglpHZa6RomNNIhxeRbOBg6_c7OTnjwL__HSIWfyUCigSop8OH7L08HqNu4tWkeKbeN-KmlBb"/>
            </div>
        </section>
        <!-- 1. Business Identity Section -->
        <section class="scroll-mt-24 space-y-unit*4" id="business-identity">
            <div class="flex items-center gap-4 mb-8">
                <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-white">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">business_center</span>
                </div>
                <div>
                    <h2 class="font-headline-lg-mobile text-headline-lg-mobile font-extrabold text-primary">Business Identity</h2>
                    <p class="text-on-surface-variant font-body-md">Tell us about yourself and your professional identity.</p>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-white p-8 blueprint-border rounded-xl">
                <div class="space-y-2">
                    <label class="font-label-md text-on-surface-variant uppercase tracking-wider">Full Name</label>
                    <input class="w-full p-4 bg-surface-container-low border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="e.g. Ramesh Kumar" type="text"/>
                </div>
                <div class="space-y-2">
                    <label class="font-label-md text-on-surface-variant uppercase tracking-wider">Business Name (Optional)</label>
                    <input class="w-full p-4 bg-surface-container-low border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="e.g. RK Electrical Solutions" type="text"/>
                </div>
                <div class="space-y-2">
                    <label class="font-label-md text-on-surface-variant uppercase tracking-wider">Primary Phone Number</label>
                    <input class="w-full p-4 bg-surface-container-low border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="+91 98765 43210" type="tel"/>
                </div>
                <div class="space-y-2">
                    <label class="font-label-md text-on-surface-variant uppercase tracking-wider">Service Area (Pincode)</label>
                    <input class="w-full p-4 bg-surface-container-low border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="e.g. 110001" type="text"/>
                </div>
                <div class="md:col-span-2 space-y-2">
                    <label class="font-label-md text-on-surface-variant uppercase tracking-wider">Detailed Address</label>
                    <textarea class="w-full p-4 bg-surface-container-low border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="Enter your full business or home address" rows="3"></textarea>
                </div>
            </div>
        </section>
        <!-- 2. Skills & Expertise Section -->
        <section class="scroll-mt-24 space-y-unit*4" id="skills-expertise">
            <div class="flex items-center gap-4 mb-8">
                <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-white">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">construction</span>
                </div>
                <div>
                    <h2 class="font-headline-lg-mobile text-headline-lg-mobile font-extrabold text-primary">Skills &amp; Expertise</h2>
                    <p class="text-on-surface-variant font-body-md">Select your core services and demonstrate your experience.</p>
                </div>
            </div>
            <div class="bg-white p-8 blueprint-border rounded-xl">
                <h3 class="font-title-lg mb-6">Service Categories</h3>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <label class="relative flex flex-col items-center justify-center p-6 border-2 border-outline-variant rounded-xl cursor-pointer hover:border-primary hover:bg-primary-fixed group transition-all">
                        <input class="absolute top-3 right-3 text-primary rounded" type="checkbox"/>
                        <span class="material-symbols-outlined text-4xl mb-2 text-on-surface-variant group-hover:text-primary">bolt</span>
                        <span class="font-label-md">Electrician</span>
                    </label>
                    <label class="relative flex flex-col items-center justify-center p-6 border-2 border-outline-variant rounded-xl cursor-pointer hover:border-primary hover:bg-primary-fixed group transition-all">
                        <input class="absolute top-3 right-3 text-primary rounded" type="checkbox"/>
                        <span class="material-symbols-outlined text-4xl mb-2 text-on-surface-variant group-hover:text-primary">plumbing</span>
                        <span class="font-label-md">Plumber</span>
                    </label>
                    <label class="relative flex flex-col items-center justify-center p-6 border-2 border-outline-variant rounded-xl cursor-pointer hover:border-primary hover:bg-primary-fixed group transition-all">
                        <input class="absolute top-3 right-3 text-primary rounded" type="checkbox"/>
                        <span class="material-symbols-outlined text-4xl mb-2 text-on-surface-variant group-hover:text-primary">carpenter</span>
                        <span class="font-label-md">Carpenter</span>
                    </label>
                    <label class="relative flex flex-col items-center justify-center p-6 border-2 border-outline-variant rounded-xl cursor-pointer hover:border-primary hover:bg-primary-fixed group transition-all">
                        <input class="absolute top-3 right-3 text-primary rounded" type="checkbox"/>
                        <span class="material-symbols-outlined text-4xl mb-2 text-on-surface-variant group-hover:text-primary">format_paint</span>
                        <span class="font-label-md">Painter</span>
                    </label>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-2">
                        <label class="font-label-md text-on-surface-variant uppercase tracking-wider">Years of Experience</label>
                        <select class="w-full p-4 bg-surface-container-low border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all">
                            <option>Less than 1 year</option>
                            <option>1-3 years</option>
                            <option>3-5 years</option>
                            <option>5-10 years</option>
                            <option>10+ years</option>
                        </select>
                    </div>
                    <div class="space-y-2" id="equipment">
                        <label class="font-label-md text-on-surface-variant uppercase tracking-wider">Tool/Equipment List</label>
                        <input class="w-full p-4 bg-surface-container-low border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="e.g. Drill, Multimeter, Ladder, Set of Wrenches" type="text"/>
                    </div>
                </div>
            </div>
        </section>
        <!-- 3. Verification Section -->
        <section class="scroll-mt-24 space-y-unit*4" id="verification">
            <div class="flex items-center gap-4 mb-8">
                <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-white">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                </div>
                <div>
                    <h2 class="font-headline-lg-mobile text-headline-lg-mobile font-extrabold text-primary">Verification Documents</h2>
                    <p class="text-on-surface-variant font-body-md">We need a few documents to verify your professional status.</p>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white p-6 blueprint-border rounded-xl group hover:shadow-lg transition-all">
                    <div class="flex justify-between items-start mb-4">
                        <span class="material-symbols-outlined text-3xl text-primary">badge</span>
                        <span class="bg-primary-fixed text-primary px-2 py-1 rounded text-[10px] font-bold uppercase">Required</span>
                    </div>
                    <h4 class="font-bold mb-2">Government ID (Aadhar/Voter ID)</h4>
                    <p class="text-sm text-on-surface-variant mb-6">Upload a clear photo of your ID front and back.</p>
                    <label class="block w-full text-center py-4 border-2 border-dashed border-outline-variant rounded-lg cursor-pointer hover:border-primary hover:bg-surface-container transition-all">
                        <input class="hidden" type="file"/>
                        <span class="material-symbols-outlined align-middle mr-2">upload</span>
                        <span class="font-label-md">Choose File</span>
                    </label>
                </div>
                <div class="bg-white p-6 blueprint-border rounded-xl group hover:shadow-lg transition-all">
                    <div class="flex justify-between items-start mb-4">
                        <span class="material-symbols-outlined text-3xl text-primary">credit_card</span>
                        <span class="bg-primary-fixed text-primary px-2 py-1 rounded text-[10px] font-bold uppercase">Required</span>
                    </div>
                    <h4 class="font-bold mb-2">PAN Card</h4>
                    <p class="text-sm text-on-surface-variant mb-6">For tax compliance and identity confirmation.</p>
                    <label class="block w-full text-center py-4 border-2 border-dashed border-outline-variant rounded-lg cursor-pointer hover:border-primary hover:bg-surface-container transition-all">
                        <input class="hidden" type="file"/>
                        <span class="material-symbols-outlined align-middle mr-2">upload</span>
                        <span class="font-label-md">Choose File</span>
                    </label>
                </div>
                <div class="bg-white p-6 blueprint-border rounded-xl group hover:shadow-lg transition-all">
                    <div class="flex justify-between items-start mb-4">
                        <span class="material-symbols-outlined text-3xl text-primary">account_balance</span>
                        <span class="bg-primary-fixed text-primary px-2 py-1 rounded text-[10px] font-bold uppercase">Required</span>
                    </div>
                    <h4 class="font-bold mb-2">Bank Passbook/Cheque</h4>
                    <p class="text-sm text-on-surface-variant mb-6">Where you would like to receive payments.</p>
                    <label class="block w-full text-center py-4 border-2 border-dashed border-outline-variant rounded-lg cursor-pointer hover:border-primary hover:bg-surface-container transition-all">
                        <input class="hidden" type="file"/>
                        <span class="material-symbols-outlined align-middle mr-2">upload</span>
                        <span class="font-label-md">Choose File</span>
                    </label>
                </div>
                <div class="bg-white p-6 blueprint-border rounded-xl group hover:shadow-lg transition-all">
                    <div class="flex justify-between items-start mb-4">
                        <span class="material-symbols-outlined text-3xl text-primary">verified</span>
                        <span class="bg-secondary-container text-secondary px-2 py-1 rounded text-[10px] font-bold uppercase">Optional</span>
                    </div>
                    <h4 class="font-bold mb-2">Certifications</h4>
                    <p class="text-sm text-on-surface-variant mb-6">Professional training or trade certificates.</p>
                    <label class="block w-full text-center py-4 border-2 border-dashed border-outline-variant rounded-lg cursor-pointer hover:border-primary hover:bg-surface-container transition-all">
                        <input class="hidden" type="file"/>
                        <span class="material-symbols-outlined align-middle mr-2">upload</span>
                        <span class="font-label-md">Choose File</span>
                    </label>
                </div>
            </div>
        </section>
        <!-- 4. Final Review & Declaration Section -->
        <section class="scroll-mt-24 space-y-unit*4" id="review">
            <div class="flex items-center gap-4 mb-8">
                <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-white">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">fact_check</span>
                </div>
                <div>
                    <h2 class="font-headline-lg-mobile text-headline-lg-mobile font-extrabold text-primary">Final Declaration</h2>
                    <p class="text-on-surface-variant font-body-md">Review your application and submit for verification.</p>
                </div>
            </div>
            <div class="bg-white p-8 blueprint-border rounded-xl space-y-6">
                <div class="flex gap-4 p-6 bg-surface-container-low rounded-xl border border-outline-variant">
                    <input class="mt-1 w-5 h-5 text-primary rounded focus:ring-primary cursor-pointer" id="terms" type="checkbox"/>
                    <label class="font-body-md text-on-surface" for="terms">
                        I hereby declare that the information provided is true to the best of my knowledge. I agree to the
                        <a class="text-primary font-bold underline" href="#">Terms of Service</a>,
                        <a class="text-primary font-bold underline" href="#">Partner Agreement</a>, and
                        <a class="text-primary font-bold underline" href="#">Privacy Policy</a>.
                        I understand that my account activation is subject to background verification.
                    </label>
                </div>
                <div class="flex flex-col md:flex-row items-center justify-between gap-6 pt-6">
                    <div class="flex items-center gap-3">
