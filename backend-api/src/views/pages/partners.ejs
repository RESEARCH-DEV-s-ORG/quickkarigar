<%- include("../component/header") %>
<main>
    <!-- Hero Section -->
    <section class="relative pt-24 pb-section-gap-mobile md:pb-section-gap-desktop px-margin-mobile md:px-margin-desktop overflow-hidden">
        <div class="max-w-container-max mx-auto flex flex-col md:flex-row items-center gap-12">
            <div class="w-full md:w-1/2 flex flex-col gap-6">
                <div class="flex items-center gap-2">
                    <span class="inline-block w-8 h-[2px] bg-primary"></span>
                    <span class="font-label-sm text-label-sm text-primary uppercase tracking-[0.2em]">Verified Professionals Only</span>
                </div>
                <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary">
                    Grow Your Professional Business with QuickKarigar.
                </h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">
                    Connect with thousands of customers, manage your schedule, and get paid instantly. Join India's most trusted network of skilled artisans.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 pt-4">
                    <a href="/onboard">
                        <button class="bg-primary-container text-on-primary px-8 py-4 rounded-xl font-label-md text-label-md shadow-lg hover:shadow-primary/20 hover:scale-105 transition-all text-center">
                            Become a Partner
                        </button>
                    </a>
                    <a href="/partner-apk">
                        <button class="border-2 border-primary text-primary px-8 py-4 rounded-xl font-label-md text-label-md hover:bg-primary/5 transition-all text-center">
                            Download Partner App
                        </button>
                    </a>
                </div>
            </div>
            <div class="w-full md:w-1/2 relative">
                <div class="absolute -top-12 -right-12 w-64 h-64 bg-primary/5 rounded-full blur-3xl"></div>
                <div class="relative blueprint-border rounded-2xl overflow-hidden shadow-2xl rotate-2">
                    <img alt="Professional Artisan" class="w-full h-[500px] object-cover" data-alt="A medium shot of a confident Indian electrician professional wearing a navy blue Quick Karigar branded polo shirt and a tool belt. He is working in a brightly lit modern apartment with clean white walls and contemporary wooden furniture. The lighting is crisp and high-key, highlighting the high-quality tools in his hand. The overall aesthetic is professional, corporate, and clean with a palette of deep navy and bright white." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCXPURjY1AgUokfqzkUgrlJzZr8g36DMSu0VdAVLCpfUunOqZa0AVXlQut0YCreEUvnPfewzN_X9ICEvaVZLI8ZvYb8EOf2-V4IgfTKLbwX5bZWMgL5-uQvImKGPsdbSH239duSD7b64UjQe_PhXM0wC6GDq-XjD3awwjk9LFophHprxfGwdQvQH4TIPf3ZpMDvXhOb1xdNsJ0Y8zw1JyP4i86ZghgjkK5URh3gaBTwMSVKaD6lWkeBIqs0fRh5wDY7yupB86oh_a_D"/>
                </div>
            </div>
        </div>
    </section>
    <!-- Why Join Section -->
    <section class="py-section-gap-mobile md:py-section-gap-desktop px-margin-mobile md:px-margin-desktop bg-surface-container-low">
        <div class="max-w-container-max mx-auto">
            <div class="text-center mb-16">
                <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary mb-4">Why Join the Network?</h2>
                <p class="font-body-lg text-body-lg text-on-surface-variant">Building the future of skilled home services together.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Card 1 -->
                <div class="bg-surface-container-lowest p-8 rounded-2xl blueprint-border hover:shadow-lg transition-all group">
                    <div class="w-16 h-16 bg-primary/5 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-on-primary transition-all">
                        <span class="material-symbols-outlined text-4xl" style="font-variation-settings: 'FILL' 1;">work</span>
                    </div>
                    <h3 class="font-title-lg text-title-lg text-primary mb-4">Steady Stream of Jobs</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant">Never worry about finding your next client. Our intelligent matching algorithm keeps your schedule full with high-quality leads.</p>
                </div>
                <!-- Card 2 -->
                <div class="bg-surface-container-lowest p-8 rounded-2xl blueprint-border hover:shadow-lg transition-all group">
                    <div class="w-16 h-16 bg-primary/5 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-on-primary transition-all">
                        <span class="material-symbols-outlined text-4xl" style="font-variation-settings: 'FILL' 1;">account_balance_wallet</span>
                    </div>
                    <h3 class="font-title-lg text-title-lg text-primary mb-4">Transparent Payments</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant">Get paid directly to your bank account after every job. No hidden fees, no delays, just honest compensation for your hard work.</p>
                </div>
                <!-- Card 3 -->
                <div class="bg-surface-container-lowest p-8 rounded-2xl blueprint-border hover:shadow-lg transition-all group">
                    <div class="w-16 h-16 bg-primary/5 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-on-primary transition-all">
                        <span class="material-symbols-outlined text-4xl" style="font-variation-settings: 'FILL' 1;">dashboard_customize</span>
                    </div>
                    <h3 class="font-title-lg text-title-lg text-primary mb-4">Professional Dashboard</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant">Powerful tools to track your earnings, ratings, and schedule. Manage everything from a single, intuitive interface designed for pros.</p>
                </div>
            </div>
        </div>
    </section>
    <!-- App Experience Section -->
    <section class="py-section-gap-mobile md:py-section-gap-desktop px-margin-mobile md:px-margin-desktop overflow-hidden">
        <div class="max-w-container-max mx-auto flex flex-col md:flex-row items-center gap-16">
            <div class="w-full md:w-1/2 order-2 md:order-1 relative">
                <div class="bg-primary p-4 rounded-[3rem] shadow-2xl max-w-xs mx-auto">
                    <div class="bg-white rounded-[2.5rem] h-[600px] overflow-hidden relative">
                        <!-- App Header -->
                        <div class="bg-primary p-6 text-white">
                            <div class="flex justify-between items-center mb-4">
                                <span class="material-symbols-outlined">menu</span>
                                <span class="font-bold text-sm">Partner App</span>
                                <span class="material-symbols-outlined">notifications</span>
                            </div>
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center font-bold">RK</div>
                                <div>
                                    <p class="text-xs opacity-75">Good Morning,</p>
                                    <p class="font-bold">Rahul Kumar</p>
                                </div>
                            </div>
                        </div>
                        <!-- App Content -->
                        <div class="p-4 space-y-4">
                            <div class="bg-secondary-container p-4 rounded-xl flex justify-between items-center">
                                <div>
                                    <p class="text-xs text-on-secondary-container">Today's Earnings</p>
                                    <p class="text-xl font-extrabold text-primary">₹ 4,250</p>
                                </div>
                                <span class="material-symbols-outlined text-primary text-3xl">trending_up</span>
                            </div>
                            <div class="space-y-3">
                                <p class="font-bold text-sm text-primary">Incoming Requests</p>
                                <div class="border border-outline-variant p-3 rounded-lg flex gap-3">
                                    <div class="w-10 h-10 bg-primary/5 rounded flex items-center justify-center">
                                        <span class="material-symbols-outlined text-primary">plumbing</span>
                                    </div>
                                    <div class="flex-1">
                                        <p class="font-bold text-xs">Pipe Leakage Repair</p>
                                        <p class="text-[10px] text-on-surface-variant">2.4 km away • Sector 45</p>
                                    </div>
                                    <button class="bg-primary text-white text-[10px] px-2 py-1 rounded">Accept</button>
                                </div>
                                <div class="border border-outline-variant p-3 rounded-lg flex gap-3">
                                    <div class="w-10 h-10 bg-primary/5 rounded flex items-center justify-center">
                                        <span class="material-symbols-outlined text-primary">electrical_services</span>
                                    </div>
                                    <div class="flex-1">
                                        <p class="font-bold text-xs">AC Installation</p>
                                        <p class="text-[10px] text-on-surface-variant">4.1 km away • HSR Layout</p>
                                    </div>
                                    <button class="bg-primary text-white text-[10px] px-2 py-1 rounded">Accept</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Decorative Dots -->
                <div class="absolute -z-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-blueprint-dot rounded-full"></div>
            </div>
            <div class="w-full md:w-1/2 order-1 md:order-2 flex flex-col gap-6">
                <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary">The Partner App Experience</h2>
                <p class="font-body-lg text-body-lg text-on-surface-variant">
                    Our specialized mobile application is built by engineers who understand your workflow. From real-time job notifications to one-tap invoicing, we've digitized the friction points of your business.
                </p>
                <ul class="space-y-4">
                    <li class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-primary p-1 bg-primary/5 rounded">check_circle</span>
                        <div>
                            <p class="font-bold text-primary">Smart Routing</p>
                            <p class="text-on-surface-variant text-sm">Minimize travel time with jobs clustered in your preferred areas.</p>
                        </div>
                    </li>
                    <li class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-primary p-1 bg-primary/5 rounded">check_circle</span>
                        <div>
                            <p class="font-bold text-primary">Live Ratings</p>
                            <p class="text-on-surface-variant text-sm">Build your reputation with direct feedback from satisfied customers.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </section>
    <!-- Onboarding Steps -->
    <section class="py-section-gap-mobile md:py-section-gap-desktop px-margin-mobile md:px-margin-desktop bg-tertiary text-on-tertiary">
        <div class="max-w-container-max mx-auto">
            <div class="text-center mb-16">
                <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-4">Simple 3-Step Onboarding</h2>
                <p class="font-body-lg text-body-lg text-on-tertiary-container">Join the network and start your journey in minutes.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 relative">
                <!-- Connector Line -->
                <div class="hidden md:block absolute top-12 left-0 w-full h-[2px] bg-tertiary-container -z-0"></div>
                <!-- Step 1 -->
                <div class="relative z-10 flex flex-col items-center text-center gap-6">
                    <div class="w-24 h-24 bg-primary rounded-full flex items-center justify-center font-extrabold text-3xl border-4 border-tertiary shadow-xl">1</div>
                    <div>
                        <h3 class="font-title-lg text-title-lg mb-2">Sign Up</h3>
                        <p class="font-body-md text-body-md text-on-tertiary-container">Register with your professional details and select your primary skill category.</p>
                    </div>
                </div>
                <!-- Step 2 -->
                <div class="relative z-10 flex flex-col items-center text-center gap-6">
                    <div class="w-24 h-24 bg-primary rounded-full flex items-center justify-center font-extrabold text-3xl border-4 border-tertiary shadow-xl">2</div>
                    <div>
                        <h3 class="font-title-lg text-title-lg mb-2">Verification</h3>
                        <p class="font-body-md text-body-md text-on-tertiary-container">Complete a quick background and skill check to ensure quality standards.</p>
                    </div>
                </div>
                <!-- Step 3 -->
                <div class="relative z-10 flex flex-col items-center text-center gap-6">
                    <div class="w-24 h-24 bg-primary rounded-full flex items-center justify-center font-extrabold text-3xl border-4 border-tertiary shadow-xl">3</div>
                    <div>
                        <h3 class="font-title-lg text-title-lg mb-2">Start Earning</h3>
                        <p class="font-body-md text-body-md text-on-tertiary-container">Go online and start receiving job requests in your service area immediately.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Final CTA -->
    <section class="py-section-gap-mobile md:py-section-gap-desktop px-margin-mobile md:px-margin-desktop">
        <div class="max-w-container-max mx-auto">
            <div class="bg-primary p-12 md:p-20 rounded-[2rem] text-center flex flex-col items-center gap-8 relative overflow-hidden">
                <!-- Background Decorative Circles -->
                <div class="absolute top-0 right-0 w-96 h-96 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
                <div class="absolute bottom-0 left-0 w-64 h-64 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>
                <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-white max-w-2xl">
                    Ready to take your business to the next level?
                </h2>
                <p class="font-body-lg text-body-lg text-on-primary-container max-w-xl">
                    Thousands of partners are already growing their income. Join the community today and experience the Quick Karigar difference.
                </p>
                <a href="/login">
                    <button class="bg-white text-primary px-10 py-5 rounded-xl font-label-md text-label-md font-extrabold hover:shadow-2xl hover:scale-105 transition-all">
                        Sign Up Now
                    </button>
                </a>
            </div>
        </div>
    </section>
</main>
<%- include("../component/footer") %>