<%- include("../component/header") %>
<main class="pt-20">
    <!-- Hero Section -->
    <section class="py-section-gap-mobile md:py-section-gap-desktop overflow-hidden relative">
        <div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop">
            <div class="max-w-3xl">
                <span class="text-primary font-label-sm text-label-sm uppercase tracking-widest mb-4 block">Our Mission</span>
                <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary mb-6">
                    Empowering the <br/>Indian Artisan
                </h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
                    Quick Karigar is more than just a service platform. We are an engineering-first ecosystem dedicated to bridging the gap between India's finest skilled workers and homeowners through technology, trust, and transparency.
                </p>
            </div>
        </div>
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1/3 h-2/3 bg-primary-container/5 rounded-l-full -z-10 hidden md:block"></div>
    </section>
    <!-- Our Story Section -->
    <section class="py-section-gap-mobile md:py-section-gap-desktop bg-surface-container-lowest">
        <div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
            <div class="relative group">
                <div class="absolute -inset-4 bg-primary-container/5 rounded-xl transition-transform group-hover:scale-105 duration-500"></div>
                <img alt="Professional worker" class="relative z-10 w-full aspect-[4/5] object-cover rounded-xl shadow-lg grayscale-[20%] group-hover:grayscale-0 transition-all duration-500" data-alt="A focused Indian electrician wearing a professional branded blue uniform, meticulously repairing a high-tech electrical panel in a bright modern home. The lighting is soft and natural, emphasizing the precision and technical skill of the worker. The overall aesthetic is clean, corporate, and trustworthy, with deep navy blue accents consistent with the brand's identity." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBL9YfWz3phMyzvZtGwV0vi93mTNSPnmSi7RLEKEGmuAYbhVB1lF0VZXC8r3qOXXcNnPOVQRumq3xZwZo1UcVPL5he1i82lHm50qNaPZlzPXFafc4bohfaBwKqttDJwJ1TxrhKmoA_13ziW9faz3U4ADmw86YJT6spZEAbWLe886Cs4SJH4WFadDVSYvZpKmRev-G5NVf7kqH31IJYOzVvaoKsk2LB4lAQy961InnPk86pjLw7WRVRiT7mSW7nbHKWr5vuwef4ar4Ug"/>
            </div>
            <div>
                <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-background mb-8">Our Story</h2>
                <div class="space-y-6 font-body-md text-body-md text-on-surface-variant">
                    <p>
                        Born from the frustration of navigating the unorganized home maintenance sector in urban and small-town India, Quick Karigar was founded with a singular vision: to bring engineering precision to every household task.
                    </p>
                    <p>
                        We noticed that while the country was filled with immensely talented karigars (artisans), homeowners struggled with reliability, fair pricing, and quality assurance. On the other hand, skilled workers lacked a professional platform to showcase their expertise and secure consistent work.
                    </p>
                    <p>
                        Today, we stand as a verified network where every professional is vetted, every quote is transparent, and every job is a commitment to excellence.
                    </p>
                </div>
            </div>
        </div>
    </section>
    <!-- Our Values Section -->
    <section class="py-section-gap-mobile md:py-section-gap-desktop">
        <div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop text-center mb-16">
            <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary mb-4">Values That Define Us</h2>
            <div class="w-24 h-1 bg-primary mx-auto rounded-full"></div>
        </div>
        <div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Reliability -->
            <div class="bg-white border border-outline-variant/30 p-10 rounded-xl hover:shadow-lg hover:scale-[1.02] transition-all duration-300">
                <div class="w-16 h-16 bg-primary-container/10 rounded-full flex items-center justify-center mb-8">
                    <span class="material-symbols-outlined text-primary text-3xl" data-icon="verified_user" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                </div>
                <h3 class="font-title-lg text-title-lg text-on-background mb-4">Reliability</h3>
                <p class="font-body-md text-body-md text-on-surface-variant">
                    We engineering trust. Every pro undergoes a 5-step verification process ensuring you only get the most dependable experts in your home.
                </p>
            </div>
            <!-- Transparency -->
            <div class="bg-white border border-outline-variant/30 p-10 rounded-xl hover:shadow-lg hover:scale-[1.02] transition-all duration-300">
                <div class="w-16 h-16 bg-primary-container/10 rounded-full flex items-center justify-center mb-8">
                    <span class="material-symbols-outlined text-primary text-3xl" data-icon="receipt_long" style="font-variation-settings: 'FILL' 1;">receipt_long</span>
                </div>
                <h3 class="font-title-lg text-title-lg text-on-background mb-4">Transparency</h3>
                <p class="font-body-md text-body-md text-on-surface-variant">
                    No hidden costs. Our real-time quoting system and community rating engine ensure fair market value for every artisan and customer.
                </p>
            </div>
            <!-- Inclusion -->
            <div class="bg-white border border-outline-variant/30 p-10 rounded-xl hover:shadow-lg hover:scale-[1.02] transition-all duration-300">
                <div class="w-16 h-16 bg-primary-container/10 rounded-full flex items-center justify-center mb-8">
                    <span class="material-symbols-outlined text-primary text-3xl" data-icon="groups" style="font-variation-settings: 'FILL' 1;">groups</span>
                </div>
                <h3 class="font-title-lg text-title-lg text-on-background mb-4">Inclusion</h3>
                <p class="font-body-md text-body-md text-on-surface-variant">
                    We empower the local workforce by providing them with digital tools, training, and financial access to grow their micro-businesses.
                </p>
            </div>
        </div>
    </section>
    <!-- Our Impact Section -->
    <section class="py-section-gap-mobile md:py-section-gap-desktop bg-primary-container text-white">
        <div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
                <div>
                    <div class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg mb-2">50,000+</div>
                    <p class="font-label-md text-label-md text-primary-fixed uppercase tracking-widest">Verified Pros</p>
                </div>
                <div>
                    <div class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg mb-2">1M+</div>
                    <p class="font-label-md text-label-md text-primary-fixed uppercase tracking-widest">Happy Homes</p>
                </div>
                <div>
                    <div class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg mb-2">24/7</div>
                    <p class="font-label-md text-label-md text-primary-fixed uppercase tracking-widest">Availability</p>
                </div>
            </div>
        </div>
