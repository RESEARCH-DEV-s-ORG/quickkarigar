    <!-- Final CTA Section -->
    <section class="py-section-gap-mobile md:py-section-gap-desktop">
        <div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop">
            <div class="bg-primary-container rounded-2xl p-8 md:p-20 text-center relative overflow-hidden">
                <!-- Atmospheric Grid Decoration -->
                <div class="absolute inset-0 blueprint-grid opacity-10 pointer-events-none"></div>
                <div class="relative z-10">
                    <h2 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-white mb-8">Join the Revolution</h2>
                    <p class="font-body-lg text-body-lg text-on-primary-container max-w-2xl mx-auto mb-12">
