                    <p class="font-body-md text-body-md text-on-surface-variant">COO</p>
                </div>
                <!-- Team Member 4 -->
                <div class="group">
                    <div class="aspect-square bg-surface-container-high rounded-xl mb-6 overflow-hidden">
                        <img alt="Product Head" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" data-alt="A professional headshot of a young South Asian female product manager, smiling brightly in a creative office space. The lighting is warm and inviting, complementing the modern 'Blueprint Pro' aesthetic of Quick Karigar. She embodies innovation and customer-centricity." src="https://lh3.googleusercontent.com/aida-public/AB6AXuANS6VyBZve8Zqp5K_Uq64W_LERQoj9UeTvpni_THWw8hMxsArMOiJ5rjLOcl-AV0-R_F2Py0GVqh18s9BLEPNeXyBp_PBHOtZ7MU5DK4EcrHzCjypbbIHnYHzdbLoLI-XjIhO9IUmENSzVs_WtqTHvxQQb5gQOzft8fRWkdGqNqVRb7yelnP-V398OXpUpspCpiC5LdaDhVStk3P1-IFgta0kFmpH8WBSg0LyGqfCn9AKhxwrfJPN1NfJui071SElmfSP3m6utdTKd"/>
