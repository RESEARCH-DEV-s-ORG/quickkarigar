<!DOCTYPE html>
<html class="scroll-smooth" lang="en"><head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Quick Karigar | Professional Home Services</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <style>
        .blueprint-grid {
            background-image: radial-gradient(circle, #1A237E 1px, transparent 1px);
            background-size: 32px 32px;
            opacity: 0.03;
        }
        .service-card-hover:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 25px -5px rgba(26, 35, 126, 0.1), 0 10px 10px -5px rgba(26, 35, 126, 0.04);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        /* Mobile Frame Styling */
        .app-frame {
            width: 320px;
            height: 640px;
            background: white;
            border: 12px solid #2e3132;
            border-radius: 40px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }
        .app-content {
            height: 100%;
            overflow-y: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .app-content::-webkit-scrollbar {
            display: none;
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary-fixed": "#e0e0ff",
                        "on-primary-fixed": "#000767",
                        "tertiary-container": "#2c3039",
                        "tertiary-fixed-dim": "#c4c6d2",
                        "on-tertiary-fixed-variant": "#434750",
                        "surface": "#f8f9fa",
                        "surface-container-high": "#e7e8e9",
                        "on-primary": "#ffffff",
                        "outline-variant": "#c6c5d4",
                        "surface-bright": "#f8f9fa",
                        "surface-variant": "#E1E2E9",
                        "primary": "#1A237E",
                        "surface-tint": "#4c56af",
                        "secondary-container": "#cfe6f2",
                        "inverse-primary": "#bdc2ff",
                        "blueprint-dot": "rgba(26, 35, 126, 0.03)",
                        "outline": "#767683",
                        "tertiary": "#181b23",
                        "on-surface-variant": "#454652",
                        "error": "#BA1A1A",
                        "surface-dim": "#d9dadb",
                        "on-background": "#191c1d",
                        "inverse-on-surface": "#f0f1f2",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary-fixed": "#181b24",
                        "surface-container": "#edeeef",
                        "background": "#f8f9fa",
                        "on-secondary-fixed-variant": "#354a53",
                        "on-tertiary": "#ffffff",
                        "surface-container-highest": "#e1e3e4",
                        "on-tertiary-container": "#9597a2",
                        "surface-container-low": "#f3f4f5",
                        "on-primary-fixed-variant": "#343d96",
                        "primary-fixed-dim": "#bdc2ff",
                        "on-surface": "#191c1d",
                        "on-error-container": "#93000a",
                        "on-secondary": "#ffffff",
                        "on-primary-container": "#8690ee",
                        "on-error": "#ffffff",
                        "secondary-fixed-dim": "#b4cad6",
                        "on-secondary-container": "#526772",
                        "tertiary-fixed": "#e0e2ee",
                        "secondary-fixed": "#cfe6f2",
                        "secondary": "#4c616c",
                        "inverse-surface": "#2e3132",
                        "error-container": "#ffdad6",
                        "on-secondary-fixed": "#071e27",
                        "primary-container": "#1a237e"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "margin-mobile": "20px",
                        "gutter": "16px",
                        "container-max": "1280px",
                        "unit": "8px",
                        "section-gap-mobile": "48px",
                        "section-gap-desktop": "96px",
                        "margin-desktop": "80px"
                    },
                    "fontFamily": {
                        "body-md": ["Manrope"],
                        "label-sm": ["Manrope"],
                        "title-lg": ["Manrope"],
                        "body-lg": ["Manrope"],
                        "display-lg": ["Manrope"],
                        "headline-lg": ["Manrope"],
                        "label-md": ["Manrope"]
                    },
                    "fontSize": {
                        "body-md": ["16px", {"lineHeight": "1.6", "fontWeight": "400"}],
                        "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "800"}],
                        "title-lg": ["20px", {"lineHeight": "28px", "fontWeight": "700"}],
                        "body-lg": ["20px", {"lineHeight": "1.6", "fontWeight": "400"}],
                        "display-lg": ["60px", {"lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "800"}],
                        "headline-lg": ["40px", {"lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "800"}],
                        "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.02em", "fontWeight": "700"}]
                    }
                },
            },
        }
    </script>
</head>
<body class="bg-background font-body-md text-on-surface">
<!-- Top Navigation Bar -->
<nav class="fixed top-0 left-0 right-0 w-full z-50 bg-surface/90 backdrop-blur-md border-b border-outline-variant shadow-sm">

    <div class="max-w-[1280px] mx-auto px-4 md:px-8 h-16 flex items-center justify-between">

        <!-- Logo -->
        <div class="text-xl font-extrabold text-primary tracking-tight">
            Quick Karigar
        </div>

        <!-- Desktop Menu -->
        <div class="hidden md:flex gap-8 items-center">

            <a class="text-primary font-bold border-b-2 border-primary pb-1"
               href="/">
                Find Pros
            </a>

            <a class="text-on-surface-variant font-medium hover:text-primary transition-colors"
               href="/partners">
                For Partners
            </a>

            <a class="text-on-surface-variant font-medium hover:text-primary transition-colors"
               href="/about-us">
                About Us
            </a>

        </div>

        <!-- Right Buttons -->
        <div class="hidden md:flex gap-4 items-center">

            <a href="/login">
                <button class="text-on-surface-variant font-medium hover:text-primary transition-colors">
                    Login
                </button>
            </a>

            <a href="/download-apk"
               class="bg-primary-container text-on-primary px-5 py-2 rounded-lg font-bold hover:opacity-90 transition-all">

                Download App

            </a>

        </div>

        <!-- Mobile Menu Button -->
        <button id="menuBtn"
                class="md:hidden flex flex-col gap-1.5">

            <span class="w-6 h-0.5 bg-primary rounded"></span>
            <span class="w-6 h-0.5 bg-primary rounded"></span>
            <span class="w-6 h-0.5 bg-primary rounded"></span>

        </button>

    </div>

    <!-- Mobile Menu -->
    <div id="mobileMenu"
         class="hidden md:hidden px-4 pb-4 bg-surface border-t border-outline-variant">

        <div class="flex flex-col gap-4 pt-4">

            <a class="text-primary font-bold"
               href="/">
                Find Pros
            </a>

            <a class="text-on-surface-variant font-medium hover:text-primary transition-colors"
               href="/partners">
                For Partners
            </a>

            <a class="text-on-surface-variant font-medium hover:text-primary transition-colors"
               href="/about-us">
                About Us
            </a>

            <a href="/login">
                <button class="w-full text-left text-on-surface-variant font-medium">
                    Login
                </button>
            </a>

            <a href="/download-apk"
               class="bg-primary-container text-on-primary px-5 py-3 rounded-lg font-bold text-center">

                Download App

            </a>

        </div>

    </div>

</nav>

<script>
    const menuBtn = document.getElementById("menuBtn");
    const mobileMenu = document.getElementById("mobileMenu");

    menuBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
    });
</script>